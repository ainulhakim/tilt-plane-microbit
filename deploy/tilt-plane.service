[Unit]
Description=Tilt Plane game statis + API highscore (game.ainulhakim.com) - port 8095
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/ainul/games/server.py --port 8095 --bind 127.0.0.1 --dir /home/ainul/games
Restart=always
RestartSec=3
User=ainul

[Install]
WantedBy=multi-user.target
